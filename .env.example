# ==============================================================
# CognoDB Cloud — required
# ==============================================================
COGNODB_URI=bolt+s://<instance-id>.databases.cognodb.cloud
COGNODB_USERNAME=cognodb
COGNODB_PASSWORD=<your-generated-password>

# ==============================================================
# Neo4j AuraDB — required for Neo4j benchmarks
# ==============================================================
NEO4J_URI=neo4j+s://<instance-id>.databases.neo4j.io
NEO4J_USERNAME=<auradb-username>
NEO4J_PASSWORD=<auradb-password>

# ==============================================================
# Memgraph — required for Memgraph benchmarks
# Default for local Docker: bolt://localhost:7687
# Leave USERNAME and PASSWORD blank for anonymous (default) auth.
# ==============================================================
MEMGRAPH_URI=bolt://localhost:7687
MEMGRAPH_USERNAME=
MEMGRAPH_PASSWORD=

# ==============================================================
# FalkorDB — local Docker or remote
# ==============================================================
FALKORDB_HOST=localhost
FALKORDB_PORT=6379

# ==============================================================
# ArangoDB — local Docker or remote (web UI: http://localhost:8529)
# ==============================================================
ARANGO_HOST=localhost
ARANGO_PORT=8529
ARANGO_USERNAME=root
ARANGO_PASSWORD=<your-arangodb-password>

# KUZU_DATA_DIR=./data/kuzu

